            ns2:SupportSelfManagement ;
        ns2:knowledgeResourceHasTopic ns2:CardiovascularLateEffects,
            ns2:FollowUpCare ;
        dcterms:description "Two-page illustrated patient information sheet explaining cardiovascular complications of cancer treatment, assessment and monitoring before, during and after treatment, and practical measures to support cardiovascular health." ;
