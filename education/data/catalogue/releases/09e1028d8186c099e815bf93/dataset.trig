            owl:NamedIndividual ;
        rdfs:label "Ficha del paciente: Cardio-oncología" ;
        ns1:accessConditions "Public" ;
        ns1:applicabilityNotes "General oncology patient information, updated 2024; not specifically developed for AYA survivors. Covers cardiovascular risks, monitoring and prevention before, during and after treatment. Suitable as background education, with exercise, medication and surveillance advice interpreted in the participant’s clinical context." ;
