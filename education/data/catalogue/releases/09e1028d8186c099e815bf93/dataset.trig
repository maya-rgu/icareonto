        dcterms:identifier "MAYA-EDU-0020" ;
        dcterms:language "en"^^xsd:language ;
        dcterms:publisher "Young Lives vs Cancer" ;
        dcterms:rights "Link / Signpost Only" ;
        dcterms:source <https://www.younglivesvscancer.org.uk/cancer-info-support/body-and-health/getting-back-to-normal-after-treatment-ends/> ;
        dcterms:title "Getting Back to Normal After Treatment Ends" .

    <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0021> a ns2:EducationalResource,
            ns2:HealthLiteracyResource,
            owl:NamedIndividual ;
        rdfs:label "Relationships after cancer treatment" ;
        ns1:accessConditions "Public" ;
        ns1:applicabilityNotes "Youth-focused survivorship guidance addressing relationship adjustment and communication. Includes discussing treatment-related fertility effects with a partner, rather than detailed fertility guidance." ;
        ns1:completionStatus "Complete" ;
        ns1:curationStatus "Approved" ;
        ns1:journeyStage "After treatment / survivorship" ;
        ns1:resourceRole "Direct Educational Resource" ;
        ns1:reviewedBy "INO" ;
        ns1:reviewedOn "2026-11-03"^^xsd:date ;
        ns2:healthLiteracyResourceAddressesNeed ns2:InformationApplicationSupportNeed,
            ns2:InformationComprehensionSupportNeed,
            ns2:SocialSupportNeed ;
        ns2:knowledgeResourceHasAudience ns2:AYASurvivorAudience ;
        ns2:knowledgeResourceHasComplexityLevel ns2:FoundationalComplexity ;
        ns2:knowledgeResourceHasFormat ns2:WrittenText ;
        ns2:knowledgeResourceHasPurpose ns2:ExplainHealthTopic,
            ns2:SupportDisclosure,
            ns2:SupportSelfManagement ;
        ns2:knowledgeResourceHasTopic ns2:FollowUpCare,
            ns2:MentalHealthAndEmotionalWellbeing ;
        dcterms:description "Guidance for young people navigating relationships after cancer treatment, including family dynamics, friendships, romantic relationships, independence and communicating personal needs and concerns." ;
        dcterms:identifier "MAYA-EDU-0021" ;
        dcterms:language "en"^^xsd:language ;
        dcterms:publisher "Teenage Cancer Trust" ;
        dcterms:rights "Link / Signpost Only" ;
        dcterms:source <https://www.teenagecancertrust.org/information-about-cancer/relationships-after-cancer-treatment> ;
        dcterms:title "Relationships after cancer treatment" .

    <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0023> a ns2:EducationalResource,
            ns2:HealthLiteracyResource,
            owl:NamedIndividual ;
        rdfs:label "Overwhelmed by diet and cancer advice? You’re not alone" ;
        ns1:accessConditions "Restricted" ;
        ns1:applicabilityNotes "Designed for people in their 20s, 30s and 40s during and after treatment, including people living with cancer long-term. Uses short sections, reduced text and imagery to accommodate fatigue and reading difficulties. Full-guide access requires name and email registration." ;
        ns1:completionStatus "Complete" ;
        ns1:curationStatus "Approved" ;
        ns1:journeyStage "After treatment / survivorship",
            "During treatment" ;
        ns1:resourceRole "Direct Educational Resource" ;
        ns1:reviewedBy "INO" ;
        ns1:reviewedOn "2026-11-03"^^xsd:date ;
        ns2:healthLiteracyResourceAddressesNeed ns2:InformationApplicationSupportNeed,
            ns2:InformationAppraisalSupportNeed,
            ns2:InformationComprehensionSupportNeed,
            ns2:SelfManagementSupportNeed ;
        ns2:knowledgeResourceHasAccessibilityFeature ns2:PlainLanguage ;
        ns2:knowledgeResourceHasAudience ns2:AYASurvivorAudience ;
        ns2:knowledgeResourceHasComplexityLevel ns2:FoundationalComplexity ;
        ns2:knowledgeResourceHasFormat ns2:WrittenText ;
        ns2:knowledgeResourceHasPurpose ns2:ExplainHealthTopic,
            ns2:SupportBehaviourChange,
            ns2:SupportSelfManagement ;
        ns2:knowledgeResourceHasTopic ns2:Nutrition ;
        dcterms:description "Illustrated nutrition guide for people living with and beyond cancer, supporting informed food choices, understanding conflicting dietary advice and managing eating difficulties through practical guidance and recipes." ;
        dcterms:identifier "MAYA-EDU-0023" ;
        dcterms:language "en"^^xsd:language ;
        dcterms:publisher "Trekstock" ;
        dcterms:rights "Link / Signpost Only" ;
        dcterms:source <https://www.trekstock.com/get-support/nutrition-guide> ;
        dcterms:title "Overwhelmed by diet and cancer advice? You’re not alone" .

    <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0030> a ns2:EducationalResource,
            ns2:HealthLiteracyResource,
            owl:NamedIndividual ;
        rdfs:label "Teenagers and young adults affected by cancer" ;
        ns1:accessConditions "Public" ;
        ns1:applicabilityNotes "Primarily signposting rather than detailed educational guidance. Includes UK-specific services, rights and eligibility criteria. Young carers are a separate audience from young people diagnosed with cancer." ;
        ns1:completionStatus "Complete" ;
        ns1:curationStatus "Approved" ;
        ns1:journeyStage "After treatment / survivorship",
            "Before treatment",
            "During treatment" ;
        ns1:resourceDateText "2026" ;
        ns1:resourceRole "Direct Educational Resource" ;
        ns1:reviewedBy "INO" ;
        ns1:reviewedOn "2026-11-03"^^xsd:date ;
        ns2:healthLiteracyResourceAddressesNeed ns2:HealthcareNavigationSupportNeed,
            ns2:InformationAccessSupportNeed,
            ns2:SocialSupportNeed ;
        ns2:knowledgeResourceHasAudience ns2:AYASurvivorAudience,
            ns2:CaregiverAudience ;
        ns2:knowledgeResourceHasComplexityLevel ns2:FoundationalComplexity ;
        ns2:knowledgeResourceHasFormat ns2:WrittenText ;
        ns2:knowledgeResourceHasPurpose ns2:SupportCareNavigation ;
        ns2:knowledgeResourceHasTopic ns2:FollowUpCare,
            ns2:MentalHealthAndEmotionalWellbeing ;
        dcterms:description "Information and signposting to age-appropriate cancer support for teenagers, young adults and young carers, including practical, emotional, financial and peer-support services." ;
        dcterms:identifier "MAYA-EDU-0030" ;
        dcterms:language "en"^^xsd:language ;
        dcterms:publisher "Macmillan Cancer Support" ;
        dcterms:rights "Link / Signpost Only" ;
        dcterms:source <https://www.macmillan.org.uk/cancer-information-and-support/get-help/teenagers-and-young-adults> ;
        dcterms:title "Teenagers and young adults affected by cancer" .
}

<http://maya-project.eu/icareonto/education/graphs/activities> {
    <http://maya-project.eu/icareonto/education/activity-templates/EDU-AFTER-TREATMENT> a ns2:EducationActivity,
            ns2:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Adjusting to life after treatment" ;
        ns2:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-AFTER-TREATMENT/goal> ;
        ns1:learningObjective "Recognise an information or support need concerning life after treatment and identify a suitable source of support." ;
        ns1:learningStep "1. Ask which aspect of adjustment the participant wishes to discuss, without inferring a literacy need from emotional distress alone.",
            "2. Offer a reviewed resource matching the recorded need, topic and language.",
            "3. Invite reflection on what feels relevant and what remains unclear.",
            "4. Identify a person or service the participant may choose to approach; follow the avatar's operational support and escalation arrangements." ;
        ns1:reflectionPrompt "1. Which part of this information feels relevant to your situation?",
            "2. Who could you talk to, or what further information would help?" ;
        ns1:templateStatus "Draft" ;
        ns2:healthLiteracyInterventionAddressesNeed ns2:InformationComprehensionSupportNeed,
            ns2:SelfManagementSupportNeed,
            ns2:SocialSupportNeed ;
        ns2:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0009>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0010>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0011>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0013>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0019>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0020>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0021>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0030> .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-CV-FOLLOWUP> a ns2:EducationActivity,
            ns2:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Understanding cardiovascular follow-up" ;
        ns2:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-CV-FOLLOWUP/goal> ;
        ns1:learningObjective "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up." ;
        ns1:learningStep "1. Introduce the topic using the participant's stated question and identified support need.",
            "2. Offer a suitable reviewed resource in the participant's language and explain its access conditions.",
            "3. Invite the participant to explain the main message in their own words and identify any unclear information.",
            "4. Help the participant prepare a question for their care team; personal monitoring decisions remain with the care team." ;
        ns1:reflectionPrompt "1. In your own words, what is the main reason for the follow-up described in this resource?",
            "2. What would you like your care team to explain about your own follow-up?" ;
        ns1:templateStatus "Draft" ;
        ns2:healthLiteracyInterventionAddressesNeed ns2:CareTeamCommunicationSupportNeed,
            ns2:InformationComprehensionSupportNeed ;
        ns2:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0004>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0017>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0018> .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES> a ns2:EducationActivity,
            ns2:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Making manageable everyday health choices" ;
        ns2:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES/goal> ;
        ns1:learningObjective "Identify one practical nutrition or activity question or action relevant to the participant's interests and circumstances." ;
        ns1:learningStep "1. Ask whether the participant wants information about food choices or physical activity.",
            "2. Select a resource matching that topic, the identified support need and the participant's preferences.",
            "3. Invite the participant to identify one manageable idea and any barriers or questions.",
            "4. Distinguish general educational information from an individual dietary or exercise prescription." ;
        ns1:reflectionPrompt "1. Which idea from the resource would you like to explore?",
            "2. What support or advice would you need before trying it?" ;
        ns1:templateStatus "Draft" ;
        ns2:healthLiteracyInterventionAddressesNeed ns2:InformationApplicationSupportNeed,
            ns2:SelfManagementSupportNeed ;
        ns2:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0005>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0007>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0008>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0023> .

    <http://maya-project.eu/icareonto/education/graphs/activities> a owl:Ontology ;
        rdfs:label "MAYA draft educational activity templates"@en ;
        owl:imports <http://maya-project.eu/icareonto/education/graphs/resources> .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-AFTER-TREATMENT/goal> a ns2:Goal,
            owl:NamedIndividual ;
        rdfs:label "Recognise an information or support need concerning life after treatment and identify a suitable source of support." ;
        ns2:goalDescriptionText "Recognise an information or support need concerning life after treatment and identify a suitable source of support."^^xsd:string .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-CV-FOLLOWUP/goal> a ns2:Goal,
            owl:NamedIndividual ;
        rdfs:label "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up." ;
        ns2:goalDescriptionText "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up."^^xsd:string .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES/goal> a ns2:Goal,
            owl:NamedIndividual ;
        rdfs:label "Identify one practical nutrition or activity question or action relevant to the participant's interests and circumstances." ;
        ns2:goalDescriptionText "Identify one practical nutrition or activity question or action relevant to the participant's interests and circumstances."^^xsd:string .

