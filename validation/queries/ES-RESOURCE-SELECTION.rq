PREFIX icare: <http://maya-project.eu/icareonto/>
PREFIX demo: <https://example.org/maya/demo/es/>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?resource WHERE {
  demo:literacy-result icare:healthLiteracyResultIdentifiesNeed ?need .
  ?resource icare:healthLiteracyResourceAddressesNeed ?need ;
            icare:knowledgeResourceHasTopic icare:CardiovascularLateEffects ;
            icare:knowledgeResourceHasComplexityLevel icare:FoundationalComplexity ;
            dcterms:language ?language .
  FILTER(STR(?language) = "es-ES")
}
