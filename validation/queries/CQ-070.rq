PREFIX icare: <http://maya-project.eu/icareonto/>
PREFIX demo: <https://example.org/maya/demo/es/>
SELECT DISTINCT ?resource WHERE {
  ?activity icare:activityContributesToGoal demo:walking-goal .
  ?recommendation icare:recommendationRecommendsActivity ?activity .
  ?resource icare:knowledgeResourceSupportsRecommendation ?recommendation .
}
