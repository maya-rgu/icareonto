PREFIX icare: <http://maya-project.eu/icareonto/>
PREFIX demo: <https://example.org/maya/demo/es/>
PREFIX test: <https://example.org/maya/demo/cq-tests/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?activity WHERE { ?activity icare:activityHasTrigger demo:symptom-trigger . }
