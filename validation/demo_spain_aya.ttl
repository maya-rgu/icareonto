@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix demo: <https://example.org/maya/demo/es/> .
@prefix icare: <http://maya-project.eu/icareonto/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/maya/demo/es> a owl:Ontology ;
    rdfs:label "Fictional Spanish AYA survivor — technical test graph"@en ;
    dcterms:description "All people, pilot sites, clinical records, assessments, recommendations, educational resources and dialogue are fictional technical fixtures. This graph contains no real patient data and asserts no real site participation, clinical validation or medical advice. Scores and care activities are authored examples, not outputs of a validated prediction model or automated clinical rules."@en ;
    owl:imports <http://maya-project.eu/icareonto> ;
    owl:versionInfo "Synthetic fixture 0.1; 2026-10-30" .

demo:care-plan a icare:CarePlan,
        owl:NamedIndividual ;
    rdfs:label "Fictional participant-agreed support plan"@en ;
    icare:carePlanCreatedAt demo:time-baseline ;
    icare:carePlanHasGoal demo:nutrition-goal,
        demo:walking-goal ;
    icare:carePlanHasParticipation demo:care-plan-participation ;
    icare:carePlanHasStatus icare:ActiveCarePlan ;
    icare:carePlanIncludesActivity demo:clinical-review,
        demo:exercise-intervention,
        demo:literacy-intervention,
        demo:nutrition-intervention,
        demo:referral ;
    icare:carePlanIntendedFor demo:participant ;
    icare:carePlanName "DEMO-ES-AYA-001 support plan"^^xsd:string ;
    icare:carePlanUpdatedAt demo:time-followup .

demo:consent a icare:ConsentRecord,
        owl:NamedIndividual ;
    rdfs:label "Fictional consent record for technical demonstration"@en ;
    icare:consentRecordAppliesToKnowledgeGraph demo:participant-knowledge-graph ;
    icare:consentRecordGrantedBy demo:participant ;
    icare:consentRecordHasStatus icare:ConsentGranted ;
    icare:consentRecordValidDuring demo:enrolment-period ;
    icare:hasVerificationStatus icare:Unverified ;
    rdfs:comment "A synthetic consent decision; it neither represents real consent nor implements access control."@en .

demo:dialogue-session a icare:DialogueSession,
        owl:NamedIndividual ;
    rdfs:label "Fictional Spanish health-literacy conversation"@en ;
    icare:activityExecutionHasSource demo:source-participant ;
    icare:dialogueSessionDeliveredThroughService demo:dialogue-service ;
    icare:dialogueSessionHasAgentParticipant demo:avatar ;
    icare:dialogueSessionHasParticipant demo:participant ;
    icare:dialogueSessionHasTurn demo:response,
        demo:utterance ;
    icare:dialogueSessionStartedAt demo:time-dialogue ;
    icare:dialogueSessionUsesStrategy icare:PlainLanguageStrategy .

demo:education-service-use a icare:ServiceUseEvent,
        owl:NamedIndividual ;
    rdfs:label "Fictional educational service use"@en ;
    icare:activityExecutionHasSource demo:source-participant ;
    icare:activityExecutionOccursAt demo:time-dialogue ;
    icare:serviceUseEventHasUser demo:participant ;
    icare:serviceUseEventSupportsActivity demo:literacy-intervention ;
    icare:serviceUseEventUsesService demo:education-service .

demo:enrolment a icare:ParticipantEnrolment,
        owl:NamedIndividual ;
    rdfs:label "Fictional enrolment"@en ;
    icare:participantEnrolmentAssignedToArm demo:study-arm ;
    icare:participantEnrolmentAtSite demo:pilot-site ;
    icare:participantEnrolmentForPerson demo:participant ;
    icare:participantEnrolmentHasStatus icare:ActiveEnrolmentStatus ;
    icare:participantEnrolmentInPhase demo:pilot-phase ;
    icare:participantEnrolmentInStudy demo:study ;
    icare:participantEnrolmentValidDuring demo:enrolment-period .

demo:health-hub a icare:HealthHub,
        owl:NamedIndividual ;
    rdfs:label "Fictional Spanish Health Hub deployment"@en ;
    icare:healthHubIncludesDevice demo:blood-pressure-monitor,
        demo:scale,
        demo:smart-mirror ;
    icare:healthHubProvidesService demo:dialogue-service,
        demo:education-service,
        demo:monitoring-service .

demo:model-execution a icare:ModelExecution,
        owl:NamedIndividual ;
    rdfs:label "Authored example of a model execution"@en ;
    icare:modelExecutionExecutedAt demo:time-followup ;
    icare:modelExecutionExecutes demo:demo-model ;
    icare:modelExecutionGeneratesRiskProfile demo:risk-profile ;
    icare:modelExecutionUsesInput demo:model-input ;
    rdfs:comment "This authored test fixture did not run a predictive algorithm. The score has no calibrated scale, horizon or clinical interpretation."@en .

demo:resource-late-effects-en a icare:HealthLiteracyResource,
        owl:NamedIndividual ;
    rdfs:label "Demo English late-effects explainer"@en ;
    icare:healthLiteracyResourceAddressesNeed icare:InformationComprehensionSupportNeed ;
    icare:knowledgeResourceHasAccessibilityFeature icare:PlainLanguage ;
    icare:knowledgeResourceHasAudience icare:AYASurvivorAudience ;
    icare:knowledgeResourceHasComplexityLevel icare:FoundationalComplexity ;
    icare:knowledgeResourceHasFormat icare:WrittenText ;
    icare:knowledgeResourceHasPurpose icare:ExplainHealthTopic ;
    icare:knowledgeResourceHasTopic icare:CardiovascularLateEffects ;
    dcterms:description "Fictional catalogue metadata only; no real document or approved health guidance exists."@en ;
    dcterms:identifier "resource-late-effects-en" ;
    dcterms:language "en-GB"^^xsd:language .

demo:resource-nutrition-es a icare:EducationalResource,
        owl:NamedIndividual ;
    rdfs:label "Demo Spanish nutrition leaflet"@en ;
    icare:knowledgeResourceContainsRecommendation demo:recommendation-nutrition ;
    icare:knowledgeResourceHasAccessibilityFeature icare:PlainLanguage ;
    icare:knowledgeResourceHasAudience icare:AYASurvivorAudience ;
    icare:knowledgeResourceHasComplexityLevel icare:FoundationalComplexity ;
    icare:knowledgeResourceHasFormat icare:WrittenText ;
    icare:knowledgeResourceHasPurpose icare:SupportSelfManagement ;
    icare:knowledgeResourceHasTopic icare:Nutrition ;
    icare:knowledgeResourceSupportsRecommendation demo:recommendation-nutrition ;
    dcterms:description "Fictional catalogue metadata only; no real document or approved health guidance exists."@en ;
    dcterms:identifier "resource-nutrition-es" ;
    dcterms:language "es-ES"^^xsd:language .

demo:resource-walking-es a icare:EducationalResource,
        owl:NamedIndividual ;
    rdfs:label "Demo Spanish activity-support leaflet"@en ;
    icare:knowledgeResourceContainsRecommendation demo:recommendation-walking ;
    icare:knowledgeResourceHasAccessibilityFeature icare:PlainLanguage ;
    icare:knowledgeResourceHasAudience icare:AYASurvivorAudience ;
    icare:knowledgeResourceHasComplexityLevel icare:FoundationalComplexity ;
    icare:knowledgeResourceHasFormat icare:WrittenText ;
    icare:knowledgeResourceHasPurpose icare:SupportBehaviourChange ;
    icare:knowledgeResourceHasTopic icare:PhysicalActivity ;
    icare:knowledgeResourceSupportsRecommendation demo:recommendation-walking ;
    dcterms:description "Fictional catalogue metadata only; no real document or approved health guidance exists."@en ;
    dcterms:identifier "resource-walking-es" ;
    dcterms:language "es-ES"^^xsd:language .

demo:symptom-recommendation a icare:Recommendation,
        owl:NamedIndividual ;
    rdfs:label "Fictional recommendation to discuss a reported concern"@en ;
    icare:recommendationAppliesToSymptom demo:fatigue ;
    icare:recommendationRecommendsActivity demo:clinical-review .

demo:activity-behaviour a icare:PhysicalActivityBehaviour,
        owl:NamedIndividual ;
    rdfs:label "Irregular physical activity — fictional self-report"@en ;
    icare:behaviourInfluencesRiskFactor demo:low-activity-risk-factor .

demo:activity-behaviour-record a icare:BehaviourRecord,
        owl:NamedIndividual ;
    rdfs:label "Activity self-report record"@en ;
    icare:behaviourHasChangeStage icare:PreparationStage ;
    icare:behaviourRecordHasMetric demo:activity-metric ;
    icare:behaviourRecordHasSource demo:source-participant ;
    icare:behaviourRecordRecordedAt demo:time-baseline ;
    icare:behaviourRecordRecordsBehaviour demo:activity-behaviour ;
    icare:behaviourRecordRelatesToActivity demo:exercise-intervention ;
    icare:behaviourRecordRelatesToGoal demo:walking-goal .

demo:activity-metric a icare:BehaviourMetric,
        owl:NamedIndividual ;
    rdfs:label "Fictional weekly activity metric"@en ;
    icare:behaviourMetricHasType icare:PhysicalActivityDuration ;
    icare:behaviourMetricNumericValue 60.0 ;
    icare:behaviourMetricUnit "minutes/week"^^xsd:string .

demo:adverse-cardiac-event a icare:AdverseCardiacEvent,
        owl:NamedIndividual ;
    rdfs:label "Generic adverse cardiac event — demonstration target"@en .

demo:baseline-dbp-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "baseline dbp event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:activityExecutionUsesDevice demo:blood-pressure-monitor ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:bp-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:baseline-dbp-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:diastolic-bp ;
    icare:measurementEventUsesInstrument demo:blood-pressure-monitor .

demo:baseline-dbp-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "baseline dbp quantity"@en ;
    icare:quantityNumericValue 82.0 ;
    icare:quantityValueHasUnit demo:unit-mmhg .

demo:baseline-dbp-result a icare:ObservationResult,
        owl:NamedIndividual ;
    rdfs:label "baseline dbp result"@en ;
    icare:observationAssociatedWithStudyTimepoint demo:baseline-study-timepoint ;
    icare:observationHasQuantityValue demo:baseline-dbp-quantity .

demo:baseline-height-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "baseline height event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:activityExecutionUsesDevice demo:height-instrument ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:body-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:baseline-height-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:height ;
    icare:measurementEventUsesInstrument demo:height-instrument .

demo:baseline-height-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "baseline height quantity"@en ;
    icare:quantityNumericValue 1.68 ;
    icare:quantityValueHasUnit demo:unit-m .

demo:baseline-sbp-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "baseline sbp event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:activityExecutionUsesDevice demo:blood-pressure-monitor ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:bp-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:baseline-sbp-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:systolic-bp ;
    icare:measurementEventUsesInstrument demo:blood-pressure-monitor .

demo:baseline-sbp-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "baseline sbp quantity"@en ;
    icare:quantityNumericValue 128.0 ;
    icare:quantityValueHasUnit demo:unit-mmhg .

demo:baseline-sbp-result a icare:ObservationResult,
        owl:NamedIndividual ;
    rdfs:label "baseline sbp result"@en ;
    icare:observationAssociatedWithStudyTimepoint demo:baseline-study-timepoint ;
    icare:observationHasQuantityValue demo:baseline-sbp-quantity .

demo:baseline-weight-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "baseline weight event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:activityExecutionUsesDevice demo:scale ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:body-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:baseline-weight-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:weight ;
    icare:measurementEventUsesInstrument demo:scale .

demo:baseline-weight-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "baseline weight quantity"@en ;
    icare:quantityNumericValue 74.0 ;
    icare:quantityValueHasUnit demo:unit-kg .

demo:bmi a icare:DerivedParameter,
        owl:NamedIndividual ;
    rdfs:label "Body mass index"@en ;
    icare:derivedParameterDerivedFrom demo:height,
        demo:weight ;
    icare:parameterCode "DEMO-BMI"^^xsd:string ;
    icare:parameterCodeSystem "https://example.org/maya/demo/codes/parameters"^^xsd:anyURI ;
    icare:parameterName "Body mass index"^^xsd:string .

demo:bmi-derivation-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "Derived BMI calculation"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:measurementEventHasOutput demo:bmi-result ;
    icare:measurementEventMeasures demo:bmi .

demo:bmi-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "Synthetic BMI quantity"@en ;
    icare:quantityNumericValue 26.22 ;
    icare:quantityValueHasUnit demo:unit-bmi .

demo:bmi-result a icare:ObservationResult,
        owl:NamedIndividual ;
    rdfs:label "Synthetic derived BMI result"@en ;
    icare:observationDerivedFromObservation demo:baseline-height-result,
        demo:baseline-weight-result ;
    icare:observationHasQuantityValue demo:bmi-quantity .

demo:bp-method a icare:MeasurementMethod,
        owl:NamedIndividual ;
    rdfs:label "Fictional oscillometric measurement method"@en .

demo:cancer-history a icare:CancerTreatmentHistory,
        owl:NamedIndividual ;
    rdfs:label "Historical cancer treatment summary"@en ;
    icare:cancerTreatmentHistoryHasRecord demo:treatment-record .

demo:care-plan-participation a icare:CarePlanParticipation,
        owl:NamedIndividual ;
    rdfs:label "Participant involvement in the support plan"@en ;
    icare:participationHasParticipant demo:participant ;
    icare:participationHasRole demo:participant-role .

demo:clinical-profile a icare:ClinicalProfile,
        owl:NamedIndividual ;
    rdfs:label "Fictional survivorship clinical profile"@en ;
    icare:clinicalProfileHasCurrentStatus icare:RemissionClinicalStatus ;
    icare:clinicalProfileIncludesRecord demo:symptom-record .

demo:communication-preference a icare:CommunicationPreference,
        owl:NamedIndividual ;
    rdfs:label "Smart mirror communication preference"@en ;
    icare:preferenceRecordedAt demo:time-enrolment ;
    icare:preferredCommunicationChannel icare:SmartMirrorChannel .

demo:contact-preference a icare:ContactPreference,
        owl:NamedIndividual ;
    rdfs:label "Evening contact preference"@en ;
    icare:preferenceRecordedAt demo:time-enrolment ;
    icare:preferredContactTime icare:EveningTimeOfDay .

demo:demo-model a icare:PredictionModel,
        owl:NamedIndividual ;
    rdfs:label "DEMO ONLY — unvalidated illustrative model"@en ;
    icare:modelIdentifier "DEMO-NOT-A-CLINICAL-MODEL"^^xsd:string ;
    icare:modelVersion "0.1-synthetic"^^xsd:string .

demo:dialogue-context a icare:DialogueContext,
        owl:NamedIndividual ;
    rdfs:label "Context for the fictional explanation"@en ;
    icare:dialogueContextAddressesIntent icare:RequestExplanation ;
    icare:dialogueContextIncludesEntity demo:health-literacy-record,
        demo:information-preference,
        demo:language-preference,
        demo:literacy-intervention,
        demo:risk-profile,
        demo:symptom-record .

demo:digital-literacy a icare:DigitalLiteracy,
        owl:NamedIndividual ;
    rdfs:label "Comfortable with everyday digital services"@en ;
    icare:digitalLiteracyHasLevel icare:AdequateLiteracy .

demo:digital-literacy-record a icare:SocialContextRecord,
        owl:NamedIndividual ;
    rdfs:label "digital literacy record"@en ;
    icare:socialContextRecordHasSource demo:source-questionnaire ;
    icare:socialContextRecordRecordedAt demo:time-baseline ;
    icare:socialContextRecordRecordsFactor demo:digital-literacy .

demo:evidence-rule a icare:SafetyRule,
        owl:NamedIndividual ;
    rdfs:label "Fictional evidence-grounding rule"@en ;
    icare:safetyRuleHasType icare:EvidenceGroundingRule ;
    icare:safetyRuleText "Demonstration responses refer to a labelled fictional resource and do not diagnose or recommend treatment."^^xsd:string .

demo:fatigue-severity a icare:Severity,
        owl:NamedIndividual ;
    rdfs:label "Illustrative mild reported symptom severity"@en ;
    icare:severityHasSeverityLevel icare:MildSeverity .

demo:followup-dbp-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "followup dbp event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-followup ;
    icare:activityExecutionUsesDevice demo:blood-pressure-monitor ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:bp-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:followup-dbp-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:diastolic-bp ;
    icare:measurementEventUsesInstrument demo:blood-pressure-monitor .

demo:followup-dbp-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "followup dbp quantity"@en ;
    icare:quantityNumericValue 78.0 ;
    icare:quantityValueHasUnit demo:unit-mmhg .

demo:followup-dbp-result a icare:ObservationResult,
        owl:NamedIndividual ;
    rdfs:label "followup dbp result"@en ;
    icare:observationAssociatedWithStudyTimepoint demo:followup-study-timepoint ;
    icare:observationHasQuantityValue demo:followup-dbp-quantity .

demo:followup-sbp-event a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "followup sbp event"@en ;
    icare:activityExecutionHasSource demo:source-device ;
    icare:activityExecutionOccursAt demo:time-followup ;
    icare:activityExecutionUsesDevice demo:blood-pressure-monitor ;
    icare:activityExecutionUsesService demo:monitoring-service ;
    icare:measurementEventFollowsProtocol demo:bp-protocol ;
    icare:measurementEventHasContext demo:home-context ;
    icare:measurementEventHasOutput demo:followup-sbp-result ;
    icare:measurementEventHasQuality icare:ValidMeasurement ;
    icare:measurementEventMeasures demo:systolic-bp ;
    icare:measurementEventUsesInstrument demo:blood-pressure-monitor .

demo:followup-sbp-quantity a icare:QuantityValue,
        owl:NamedIndividual ;
    rdfs:label "followup sbp quantity"@en ;
    icare:quantityNumericValue 122.0 ;
    icare:quantityValueHasUnit demo:unit-mmhg .

demo:health-literacy a icare:HealthLiteracy,
        owl:NamedIndividual ;
    rdfs:label "Needs support understanding health information"@en ;
    icare:healthLiteracyHasLevel icare:LimitedLiteracy .

demo:historical-treatment-agent a icare:TreatmentAgent,
        owl:NamedIndividual ;
    rdfs:label "Doxorubicin — fictional historical exposure"@en ;
    icare:treatmentAgentName "Doxorubicin (synthetic historical record)"^^xsd:string .

demo:lifestyle-profile a icare:LifestyleProfile,
        owl:NamedIndividual ;
    rdfs:label "Fictional lifestyle profile"@en ;
    icare:lifestyleProfileIncludesBehaviourRecord demo:activity-behaviour-record,
        demo:smoking-record .

demo:literacy-measurement a icare:MeasurementEvent,
        owl:NamedIndividual ;
    rdfs:label "Fictional support-needs assessment event"@en ;
    icare:activityExecutionHasSource demo:source-questionnaire ;
    icare:activityExecutionOccursAt demo:time-baseline ;
    icare:measurementEventFollowsProtocol demo:literacy-questionnaire-protocol ;
    icare:measurementEventHasOutput demo:literacy-result ;
    icare:measurementEventMeasures demo:literacy-parameter ;
    icare:measurementEventUsesInstrument demo:literacy-questionnaire .

demo:literacy-questionnaire a icare:Questionnaire,
        owl:NamedIndividual ;
    rdfs:label "Synthetic health-literacy support-needs questionnaire"@en ;
    icare:instrumentName "DEMO-HL-NEEDS; not a validated questionnaire"^^xsd:string ;
    icare:instrumentVersion "0.1-fictional"^^xsd:string ;
    rdfs:comment "No licensed instrument or real psychometric validation is claimed."@en .

demo:literacy-questionnaire-protocol a icare:QuestionnaireProtocol,
        owl:NamedIndividual ;
    rdfs:label "Fictional support-needs questionnaire protocol"@en ;
    icare:protocolSpecifiesParameter demo:literacy-parameter .

demo:literacy-result a icare:ObservationResult,
        owl:NamedIndividual ;
    rdfs:label "Needs assessment result"@en ;
    icare:healthLiteracyResultIdentifiesNeed icare:InformationAccessSupportNeed,
        icare:InformationComprehensionSupportNeed ;
    icare:observationTextValue "Prefers brief Spanish explanations and help understanding cardiovascular follow-up information."^^xsd:string .

demo:locale a icare:Locale,
        owl:NamedIndividual ;
    rdfs:label "Spanish demonstration locale"@en ;
    icare:localeCountryCode "ES"^^xsd:string ;
    icare:localeTag "es-ES"^^xsd:language ;
    icare:localeTimeZoneIdentifier "Europe/Madrid"^^xsd:string .

demo:model-input a icare:ModelInput,
        owl:NamedIndividual ;
    rdfs:label "Fictional model input record"@en ;
    icare:modelInputDerivedFromObservation demo:followup-sbp-result ;
    icare:modelInputIncludesExposure demo:anthracycline-exposure .

demo:nutrition-instruction a icare:NutritionInstruction,
        owl:NamedIndividual ;
    rdfs:label "Illustrative instruction to discuss dietary choices"@en ;
    icare:nutritionInstructionHasActionType icare:Increase ;
    icare:nutritionInstructionTargetsComponent icare:FruitAndVegetables ;
    icare:nutritionInstructionText "Fictional discussion example about including fruit and vegetables; no clinical dietary target is prescribed."^^xsd:string .

demo:participant-knowledge-graph a icare:ParticipantKnowledgeGraph,
        owl:NamedIndividual ;
    rdfs:label "Logical collection about demo participant"@en ;
    icare:participantKnowledgeGraphAboutPerson demo:participant .

demo:performed-walking-activity a icare:ExerciseActivity,
        owl:NamedIndividual ;
    rdfs:label "Fictional 18-minute completed walk"@en ;
    icare:durationMinutes 18.0 ;
    icare:exerciseActivityHasActivityType icare:Walking .

demo:performed-walking-session a icare:PerformedExerciseSession,
        owl:NamedIndividual ;
    rdfs:label "Fictional completed walk"@en ;
    icare:activityExecutionHasSource demo:source-participant ;
    icare:activityExecutionOccursAt demo:time-followup ;
    icare:performedSessionIncludesActivity demo:performed-walking-activity ;
    icare:performedSessionRealises demo:planned-walking-session .

demo:planned-walking-session a icare:PlannedExerciseSession,
        owl:NamedIndividual ;
    rdfs:label "Illustrative planned walk"@en ;
    icare:plannedSessionFollowsPrescription demo:exercise-prescription ;
    icare:plannedSessionHasStatus icare:CompletedActivity ;
    icare:plannedSessionScheduledAt demo:time-followup .

demo:recommendation-criterion a icare:ApplicabilityCriterion,
        owl:NamedIndividual ;
    rdfs:label "Illustrative applicability condition"@en ;
    icare:criterionText "Use only in the fictional scenario after review by the fictional clinician."^^xsd:string .

demo:referral a icare:ReferralActivity,
        owl:NamedIndividual ;
    rdfs:label "Fictional professional signposting after a reported concern"@en ;
    icare:activityHasPriority icare:RoutinePriority ;
    icare:activityHasStatus icare:PlannedActivity ;
    icare:activityHasTrigger demo:symptom-trigger ;
    icare:activityRequiresReviewBy demo:clinician-role ;
    icare:carePlanActivityAdaptedToSocialContext demo:health-literacy-record .

demo:response a icare:AgentResponse,
        owl:NamedIndividual ;
    rdfs:label "Fictional grounded response"@en ;
    icare:agentResponseGeneratedBy demo:avatar ;
    icare:agentResponseGroundedInResource demo:resource-late-effects-es ;
    icare:agentResponseRespondsTo demo:utterance ;
    icare:agentResponseUsesContext demo:dialogue-context ;
    icare:dialogueTurnOccursAt demo:time-dialogue ;
    icare:turnSequenceNumber "2"^^xsd:nonNegativeInteger ;
    icare:turnText "En esta demostración puedo mostrarte un recurso ficticio en español. Las dudas sobre tu situación las revisa tu equipo sanitario."^^xsd:string .

demo:review-schedule a icare:Schedule,
        owl:NamedIndividual ;
    rdfs:label "Illustrative review schedule"@en ;
    icare:scheduleNextDueAt demo:time-review-due .

demo:risk-estimate a icare:RiskEstimate,
        owl:NamedIndividual ;
    rdfs:label "Unvalidated illustrative score; not a probability"@en ;
    icare:riskEstimateEstimatesEventRisk demo:adverse-cardiac-event ;
    icare:riskEstimateHasCategory icare:UnknownRisk ;
    icare:riskEstimateHasInterpretation demo:risk-interpretation ;
    icare:riskScore 2.0 .

demo:risk-interpretation a icare:RiskInterpretation,
        owl:NamedIndividual ;
    rdfs:label "No validated clinical interpretation"@en ;
    icare:riskInterpretationValue "Synthetic fixture score only; clinical risk remains unclassified."^^xsd:string .

demo:safety-policy a icare:SafetyPolicy,
        owl:NamedIndividual ;
    rdfs:label "Fictional demonstration safety policy"@en ;
    icare:safetyPolicyHasRule demo:evidence-rule ;
    icare:safetyPolicyVersion "DEMO-0.1"^^xsd:string .

demo:smart-mirror a icare:SmartMirror,
        owl:NamedIndividual ;
    rdfs:label "Demo smart mirror"@en ;
    icare:deviceProvidesAccessTo demo:dialogue-service,
        demo:education-service,
