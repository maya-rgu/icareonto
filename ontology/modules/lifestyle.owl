###  http://maya-project.eu/icareonto/lifestyle#hasLifestyleFactor
icare-lifestyle:hasLifestyleFactor rdf:type owl:ObjectProperty ;
                                   rdfs:domain icare-user:User ;
                                   rdfs:range icare-lifestyle:LifestyleFactor ;
                                   rdfs:label "has lifestyle factor"@en .


