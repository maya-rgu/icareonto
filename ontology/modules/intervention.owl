#################################################################

###  http://maya-project.eu/icareonto/interventions#hasAdherence
icare-interv:hasAdherence rdf:type owl:ObjectProperty ;
                          rdfs:domain icare-user:User ;
                          rdfs:range icare-interv:Adherence ;
                          rdfs:label "has adherence"@en .


###  http://maya-project.eu/icareonto/interventions#hasContraindication
icare-interv:hasContraindication rdf:type owl:ObjectProperty ;
