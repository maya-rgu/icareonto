@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix icare-core:    <http://maya-project.eu/icareonto/core#> .
@prefix icare-user:    <http://maya-project.eu/icareonto/user#> .
@prefix icare-clinical:<http://maya-project.eu/icareonto/clinical#> .
@prefix icare-lifestyle:<http://maya-project.eu/icareonto/lifestyle#> .
@prefix icare-dev:     <http://maya-project.eu/icareonto/devices#> .

icare-dev: a owl:Ontology ;
  rdfs:label "iCARE Ontology - Devices module"@en ;
  owl:imports <http://maya-project.eu/icareonto/core> ,
              <http://maya-project.eu/icareonto/user> ,
              <http://maya-project.eu/icareonto/clinical> ,
              <http://maya-project.eu/icareonto/lifestyle> .

### Device classes

icare-dev:Device a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Device"@en .

icare-dev:SmartMirror a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "Smart mirror"@en .

icare-dev:WearableDevice a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "Wearable device"@en .

icare-dev:BPMonitor a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "Blood pressure monitor"@en .

icare-dev:Scale a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "Scale"@en .

icare-dev:ECGDevice a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "ECG device"@en .

icare-dev:Sensor a owl:Class ;
  rdfs:subClassOf icare-dev:Device ;
  rdfs:label "Sensor"@en .

icare-dev:MeasurementEvent a owl:Class ;
  rdfs:subClassOf icare-core:Measurement ;
  rdfs:label "Measurement event"@en .

icare-dev:DataStream a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Data stream"@en .

icare-dev:UsageContext a owl:Class ;
  rdfs:subClassOf icare-core:Context ;
  rdfs:label "Usage context"@en .

icare-dev:OperatingMode a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Operating mode"@en .

### Device object properties

icare-dev:usesDevice a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-dev:Device ;
  rdfs:label "uses device"@en .

icare-dev:generatedByDevice a owl:ObjectProperty ;
  rdfs:domain icare-dev:MeasurementEvent ;
  rdfs:range  icare-dev:Device ;
  rdfs:label "generated by device"@en .

icare-dev:observesBiomarker a owl:ObjectProperty ;
  rdfs:domain icare-dev:MeasurementEvent ;
  rdfs:range  icare-clinical:Biomarker ;
  rdfs:label "observes biomarker"@en .

icare-dev:observesLifestyleFactor a owl:ObjectProperty ;
  rdfs:domain icare-dev:MeasurementEvent ;
  rdfs:range  icare-lifestyle:LifestyleFactor ;
  rdfs:label "observes lifestyle factor"@en .

icare-dev:hasUsageContext a owl:ObjectProperty ;
  rdfs:domain icare-dev:Device ;
  rdfs:range  icare-dev:UsageContext ;
  rdfs:label "has usage context"@en .

icare-dev:hasOperatingMode a owl:ObjectProperty ;
  rdfs:domain icare-dev:Device ;
  rdfs:range  icare-dev:OperatingMode ;
  rdfs:label "has operating mode"@en .

icare-dev:hasDataStream a owl:ObjectProperty ;
  rdfs:domain icare-dev:Device ;
  rdfs:range  icare-dev:DataStream ;
  rdfs:label "has data stream"@en .

### Device data properties

icare-dev:hasSamplingRate a owl:DatatypeProperty ;
  rdfs:domain icare-dev:DataStream ;
  rdfs:range  xsd:decimal ;
  rdfs:label "has sampling rate"@en .

icare-dev:hasAccuracy a owl:DatatypeProperty ;
  rdfs:domain icare-dev:Device ;
  rdfs:range  xsd:string ;
  rdfs:label "has accuracy"@en .
