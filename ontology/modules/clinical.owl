@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix icare-core:   <http://maya-project.eu/icareonto/core#> .
@prefix icare-user:   <http://maya-project.eu/icareonto/user#> .
@prefix icare-clinical: <http://maya-project.eu/icareonto/clinical#> .

icare-clinical: a owl:Ontology ;
  rdfs:label "iCARE Ontology - Clinical module"@en ;
  owl:imports <http://maya-project.eu/icareonto/core> ,
              <http://maya-project.eu/icareonto/user> .

### Clinical classes

icare-clinical:Diagnosis a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Diagnosis"@en .

icare-clinical:CancerType a owl:Class ;
  rdfs:subClassOf icare-clinical:Diagnosis ;
  rdfs:label "Cancer type"@en .

icare-clinical:Treatment a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Treatment"@en .

icare-clinical:Chemotherapy a owl:Class ;
  rdfs:subClassOf icare-clinical:Treatment ;
  rdfs:label "Chemotherapy"@en .

icare-clinical:Radiotherapy a owl:Class ;
  rdfs:subClassOf icare-clinical:Treatment ;
  rdfs:label "Radiotherapy"@en .

icare-clinical:Immunotherapy a owl:Class ;
  rdfs:subClassOf icare-clinical:Treatment ;
  rdfs:label "Immunotherapy"@en .

icare-clinical:Cardiotoxicity a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Cardiotoxicity"@en .

icare-clinical:CVCondition a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Cardiovascular condition"@en .

icare-clinical:RiskFactor a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Risk factor"@en .

icare-clinical:Biomarker a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Biomarker"@en .

icare-clinical:LabResult a owl:Class ;
  rdfs:subClassOf icare-core:Measurement ;
  rdfs:label "Laboratory result"@en .

icare-clinical:RiskScore a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Risk score"@en .

icare-clinical:Guideline a owl:Class ;
  rdfs:subClassOf icare-core:Entity ;
  rdfs:label "Guideline"@en .

### Clinical object properties

icare-clinical:hasDiagnosis a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:Diagnosis ;
  rdfs:label "has diagnosis"@en .

icare-clinical:hasCancerType a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:CancerType ;
  rdfs:label "has cancer type"@en .

icare-clinical:receivedTreatment a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:Treatment ;
  rdfs:label "received treatment"@en .

icare-clinical:hasCondition a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:CVCondition ;
  rdfs:label "has cardiovascular condition"@en .

icare-clinical:hasRiskFactor a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:RiskFactor ;
  rdfs:label "has risk factor"@en .

icare-clinical:hasBiomarker a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:Biomarker ;
  rdfs:label "has biomarker"@en .

icare-clinical:hasRiskScore a owl:ObjectProperty ;
  rdfs:domain icare-user:User ;
  rdfs:range  icare-clinical:RiskScore ;
  rdfs:label "has risk score"@en .

icare-clinical:basedOnBiomarker a owl:ObjectProperty ;
  rdfs:domain icare-clinical:RiskScore ;
  rdfs:range  icare-clinical:Biomarker ;
  rdfs:label "based on biomarker"@en .

icare-clinical:refersToGuideline a owl:ObjectProperty ;
  rdfs:domain icare-clinical:RiskScore ;
  rdfs:range  icare-clinical:Guideline ;
  rdfs:label "refers to guideline"@en .
