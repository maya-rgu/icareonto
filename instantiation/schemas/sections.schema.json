{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grouped iCARE Onto records",
  "description": "Optional groups of typed ontology records and relationships. IDs are unique across groups within this owner. Grouping does not change the RDF identity or ontology meaning.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clinical_profile": {"$ref": "#/$defs/section"},
    "cancer_history": {"$ref": "#/$defs/section"},
    "measurements": {"$ref": "#/$defs/section"},
    "cv_risk": {"$ref": "#/$defs/section"},
    "care_plans": {"$ref": "#/$defs/section"},
    "exercise": {"$ref": "#/$defs/section"},
    "nutrition": {"$ref": "#/$defs/section"},
    "lifestyle": {"$ref": "#/$defs/section"},
    "social_context": {"$ref": "#/$defs/section"},
    "education": {"$ref": "#/$defs/section"},
    "dialogue": {"$ref": "#/$defs/section"},
    "agents": {"$ref": "#/$defs/section"},
    "digital_services": {"$ref": "#/$defs/section"},
    "governance": {"$ref": "#/$defs/section"},
    "person_context": {"$ref": "#/$defs/section"},
    "pilot_context": {"$ref": "#/$defs/section"},
    "common": {"$ref": "#/$defs/section"}
  },
  "$defs": {
    "recordId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "termName": {"type": "string", "minLength": 1, "description": "Exact local ontology name or full iCARE Onto IRI; checked against the loaded ontology."},
    "objectReference": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["term"], "properties": {"term": {"$ref": "#/$defs/termName"}}}
      ]
    },
    "singleValue": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"$ref": "#/$defs/objectReference"}]},
    "propertyValue": {"oneOf": [{"$ref": "#/$defs/singleValue"}, {"type": "array", "items": {"$ref": "#/$defs/singleValue"}}]},
    "record": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/recordId"},
        "type": {"oneOf": [{"$ref": "#/$defs/termName"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/termName"}}]},
        "label": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/propertyValue"}}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["subject", "property", "object"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "property": {"$ref": "#/$defs/termName"},
        "object": {"$ref": "#/$defs/propertyValue"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
      }
    }
  }
}
