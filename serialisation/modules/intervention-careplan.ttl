    rdfs:label "Scheduled activity"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "An activity status indicating that the activity is scheduled."@en ;
    skos:inScheme icare:ActivityStatusScheme ;
    skos:prefLabel "Scheduled activity"@en ;
    skos:topConceptOf icare:ActivityStatusScheme .

icare:SymptomBasedTrigger a owl:Class ;
    rdfs:label "Symptom Based Trigger"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanTrigger ;
    skos:definition "A trigger based on a reported or recorded symptom."@en .

icare:UrgentPriority a icare:ActivityPriority,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Urgent priority"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "An activity-priority value indicating urgent priority."@en ;
    skos:inScheme icare:ActivityPriorityScheme ;
    skos:prefLabel "Urgent priority"@en ;
    skos:topConceptOf icare:ActivityPriorityScheme .

icare:ActivityOutcome a owl:Class ;
    rdfs:label "Activity Outcome"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "The result or outcome of a care-plan activity after it has been performed or reviewed."@en .

icare:CarePlanParticipation a owl:Class ;
    rdfs:label "Care Plan Participation"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "A representation of a person's role in a care plan, such as survivor, clinician, caregiver, or reviewer."@en .

icare:Intervention a owl:Class ;
    rdfs:label "Intervention"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A planned care-plan activity intended to reduce risk, manage symptoms, improve health behaviour, support monitoring, or address survivorship needs."@en .

icare:ActivityPriority a owl:Class ;
    rdfs:label "Activity Priority"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the relative importance or urgency assigned to a care-plan activity, such as routine, important, urgent or requiring escalation."@en .

icare:CarePlanTrigger a owl:Class ;
    rdfs:label "Care Plan Trigger"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "A reason or event that causes a care plan or activity to be created, updated, escalated, or reviewed."@en .

icare:Goal a owl:Class ;
    rdfs:label "Goal"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "A desired care, monitoring, behavioural, or clinical outcome that care-plan activities are intended to support."@en .

icare:CarePlanStatus a owl:Class ;
    rdfs:label "Care Plan Status"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the lifecycle state of a care plan, such as draft, active, paused, completed or cancelled."@en .

icare:GoalAchievementStatus a owl:Class ;
    rdfs:label "Goal Achievement Status"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing progress toward or achievement of a goal against its intended target."@en .

icare:GoalLifecycleStatus a owl:Class ;
    rdfs:label "Goal Lifecycle Status"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the operational state of a goal throughout its lifecycle and whether it remains subject to active pursuit."@en .

icare:ActivityStatus a owl:Class ;
    rdfs:label "Activity Status"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the operational or lifecycle state of a care-plan activity, such as planned, scheduled, in progress, completed, cancelled or missed."@en .

icare:ActivityPriorityScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Activity Priority scheme"@en ;
    skos:hasTopConcept icare:EscalationRequiredPriority,
        icare:ImportantPriority,
        icare:RoutinePriority,
        icare:UrgentPriority .

icare:CarePlan a owl:Class ;
    rdfs:label "Care Plan"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:altLabel "personalised care plan"@en ;
    skos:definition "Personalised plan of goals and activities used to support cardiovascular risk management, lifestyle change and follow-up."@en .

icare:CarePlanStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Care Plan Status scheme"@en ;
    skos:hasTopConcept icare:ActiveCarePlan,
        icare:CancelledCarePlan,
        icare:CompletedCarePlan,
        icare:DraftCarePlan,
        icare:PausedCarePlan .

icare:GoalAchievementStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Goal Achievement Status scheme"@en ;
    skos:hasTopConcept icare:AchievedGoalAchievementStatus,
        icare:ImprovingGoalAchievementStatus,
        icare:InProgressGoalAchievementStatus,
        icare:NotAchievedGoalAchievementStatus,
        icare:NotAttainableGoalAchievementStatus .

icare:GoalLifecycleStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Goal Lifecycle Status scheme"@en ;
    skos:hasTopConcept icare:ActiveGoalLifecycleStatus,
        icare:CancelledGoalLifecycleStatus,
        icare:CompletedGoalLifecycleStatus,
        icare:OnHoldGoalLifecycleStatus,
        icare:PlannedGoalLifecycleStatus .

icare:ActivityStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Activity Status scheme"@en ;
    skos:hasTopConcept icare:CancelledActivity,
        icare:CompletedActivity,
        icare:InProgressActivity,
        icare:MissedActivity,
        icare:PlannedActivity,
        icare:ScheduledActivity .

icare:CarePlanActivity a owl:Class ;
    rdfs:label "Care Plan Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "A planned activity within a care plan, including interventions, monitoring, assessment, follow-up, and surveillance."@en .

icare:intervention-careplan a owl:Ontology ;
    rdfs:label "Intervention and Care Plan"@en ;
    meta:reviewStatus "Draft" ;
    rdfs:comment "Represents care plans, participants, goals, interventions and other activities, triggers, schedules, priorities, statuses, outcomes and activity executions."@en ;
    owl:imports icare:clinical-profile,
        icare:core,
        icare:cv-risk,
        <http://maya-project.eu/icareonto/imports/skos-reference>,
        icare:measurement-biomarker,
        icare:metadata,
        icare:person-role,
        icare:social-context ;
    owl:versionIRI <http://maya-project.eu/icareonto/releases/0.1.0-draft/intervention-careplan> ;
    owl:versionInfo "0.1.0-draft" .

