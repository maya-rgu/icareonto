@prefix icare: <http://maya-project.eu/icareonto/> .
@prefix meta: <http://maya-project.eu/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icare:ClinicalAssessmentActivity a owl:Class ;
    rdfs:label "Clinical Assessment Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A care-plan activity involving clinical review, examination, assessment, or interpretation of health status."@en .

icare:EducationActivity a owl:Class ;
    rdfs:label "Education Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A care-plan activity that provides educational or self-management content."@en .

icare:EscalationActivity a owl:Class ;
    rdfs:label "Escalation Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A care-plan activity that routes a concern for clinical review, urgent follow-up, or safety oversight."@en .

icare:ExerciseIntervention a owl:Class ;
    rdfs:label "Exercise Intervention"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:Intervention ;
    skos:definition "An intervention involving prescribed, guided, or monitored physical activity or exercise."@en .

icare:FollowUpActivity a owl:Class ;
    rdfs:label "Follow Up Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A planned activity that continues review, monitoring, communication, or care after a prior assessment, event, or intervention."@en .

icare:MedicalCheckUpActivity a owl:Class ;
    rdfs:label "Medical Check Up Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A scheduled clinical check-up used for routine follow-up, monitoring, or review of survivorship care needs."@en .

icare:MonitoringActivity a owl:Class ;
    rdfs:label "Monitoring Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A care-plan activity that collects or reviews data to track symptoms, clinical status, measurements, adherence, or late-effect risk."@en .

icare:NutritionIntervention a owl:Class ;
    rdfs:label "Nutrition Intervention"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:Intervention ;
    skos:definition "An intervention involving dietary guidance, nutrition coaching, or behaviour change related to cardiometabolic risk."@en .

icare:ReferralActivity a owl:Class ;
    rdfs:label "Referral Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A care-plan activity involving referral to another clinician, service, programme, or specialist."@en .

icare:SurveillanceActivity a owl:Class ;
    rdfs:label "Surveillance Activity"@en ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:subClassOf icare:CarePlanActivity ;
    skos:definition "A planned activity for ongoing detection or monitoring of late effects, recurrence concerns, risk change, or clinically relevant deterioration."@en .

icare:activityContributesToGoal a owl:ObjectProperty ;
    rdfs:label "contributes to"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Goal ;
    skos:definition "Relates Care Plan Activity to Goal."@en .

icare:activityHasOutcome a owl:ObjectProperty ;
    rdfs:label "activity has outcome"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:ActivityOutcome ;
    skos:definition "Relates a care-plan activity to its result or outcome."@en .

icare:activityHasPriority a owl:ObjectProperty ;
    rdfs:label "activity has priority"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:ActivityPriority ;
    skos:definition "Relates a care-plan activity to its priority."@en .

icare:activityHasSchedule a owl:ObjectProperty ;
    rdfs:label "has schedule"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Schedule ;
    skos:definition "Relates Care Plan Activity to Schedule."@en .

icare:activityHasStatus a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:ActivityStatus ;
    skos:definition "Relates Care Plan Activity to Activity Status."@en .

icare:activityHasTrigger a owl:ObjectProperty ;
    rdfs:label "activity has trigger"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanTrigger ;
    skos:definition "Relates a care-plan activity to the trigger that caused or justified it."@en .

icare:activityOutcomeValue a owl:DatatypeProperty ;
    rdfs:label "activity outcome value"@en ;
    rdfs:domain icare:ActivityOutcome ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range xsd:string ;
    skos:definition "Records the activity outcome value."@en .

icare:activityRealisedBy a owl:ObjectProperty ;
    rdfs:label "realised by"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:ActivityExecution ;
    skos:definition "Relates Care Plan Activity to Activity Execution."@en .

icare:activityRequiresReviewBy a owl:ObjectProperty ;
    rdfs:label "requires review by"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:PersonRole ;
    skos:definition "Relates an activity to the role expected to review it."@en .

icare:carePlanActivityAdaptedToSocialContext a owl:ObjectProperty ;
    rdfs:label "adapted to"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:SocialContextRecord ;
    skos:definition "Indicates that a care-plan activity was selected or adapted in response to recorded social context."@en .

icare:carePlanActivityName a owl:DatatypeProperty ;
    rdfs:label "care plan activity name"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range xsd:string ;
    skos:definition "Records a name or title for the care plan activity."@en .

icare:carePlanActivitySupersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    rdfs:domain icare:CarePlanActivity ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanActivity ;
    skos:definition "Connects a revised Care Plan Activity to the version it replaces."@en .

icare:carePlanCreatedAt a owl:ObjectProperty ;
    rdfs:label "created at"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Timepoint ;
    skos:definition "Relates a care plan to its creation time."@en .

icare:carePlanHasGoal a owl:ObjectProperty ;
    rdfs:label "has goal"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Goal ;
    skos:definition "Relates Care Plan to Goal."@en .

icare:carePlanHasParticipation a owl:ObjectProperty ;
    rdfs:label "has participation"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanParticipation ;
    skos:definition "Relates Care Plan to Care Plan Participation."@en .

icare:carePlanHasStatus a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanStatus ;
    skos:definition "Relates Care Plan to Care Plan Status."@en .

icare:carePlanHasTrigger a owl:ObjectProperty ;
    rdfs:label "plan has trigger"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanTrigger ;
    skos:definition "Relates a care plan to the trigger or reason that caused it to be created or updated."@en .

icare:carePlanIncludesActivity a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:CarePlanActivity ;
    skos:definition "Relates Care Plan to Care Plan Activity."@en .

icare:carePlanIntendedFor a owl:ObjectProperty ;
    rdfs:label "intended for"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Person ;
    skos:definition "Relates Care Plan to Person."@en .

icare:carePlanName a owl:DatatypeProperty ;
    rdfs:label "care plan name"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range xsd:string ;
    skos:definition "Records a name or title for the care plan."@en .

icare:carePlanUpdatedAt a owl:ObjectProperty ;
    rdfs:label "updated at"@en ;
    rdfs:domain icare:CarePlan ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Timepoint ;
    skos:definition "Relates a care plan to its most recent update time."@en .

icare:goalDescriptionText a owl:DatatypeProperty ;
    rdfs:label "goal description text"@en ;
    rdfs:domain icare:Goal ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range xsd:string ;
    skos:definition "Records the goal description text for Goal."@en .

icare:goalHasAchievementStatus a owl:ObjectProperty ;
    rdfs:label "has achievement status"@en ;
    rdfs:domain icare:Goal ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:GoalAchievementStatus ;
    skos:definition "Identifies the current progress or outcome of a goal against its intended target."@en .

icare:goalHasLifecycleStatus a owl:ObjectProperty ;
    rdfs:label "has lifecycle status"@en ;
    rdfs:domain icare:Goal ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:GoalLifecycleStatus ;
    skos:definition "Identifies the current operational state of a goal in its lifecycle."@en .

icare:healthLiteracyInterventionAddressesNeed a owl:ObjectProperty ;
    rdfs:label "intervention addresses need"@en ;
    rdfs:domain icare:HealthLiteracyIntervention ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:HealthLiteracyNeedType ;
    skos:definition "Identifies the health-literacy need an intervention is intended to address."@en .

icare:interventionTargetsRiskFactor a owl:ObjectProperty ;
    rdfs:label "targets risk factor"@en ;
    rdfs:domain icare:Intervention ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:RiskFactor ;
    skos:definition "Relates Intervention to Modifiable Risk Factor."@en .

icare:measurementBasedTriggerUsesObservation a owl:ObjectProperty ;
    rdfs:label "uses observation"@en ;
    rdfs:domain icare:MeasurementBasedTrigger ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:ObservationResult ;
    skos:definition "Relates a measurement-based trigger to the observation result that caused it."@en .

icare:participationHasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain icare:CarePlanParticipation ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:Person ;
    skos:definition "Relates Care Plan Participation to Person."@en .

icare:participationHasRole a owl:ObjectProperty ;
    rdfs:label "has participation role"@en ;
    rdfs:domain icare:CarePlanParticipation ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:PersonRole ;
    skos:definition "Relates Care Plan Participation to Person Role."@en .

icare:riskBasedTriggerUsesRiskProfile a owl:ObjectProperty ;
    rdfs:label "uses risk profile"@en ;
    rdfs:domain icare:RiskBasedTrigger ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    rdfs:range icare:RiskProfile ;
