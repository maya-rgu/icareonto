    skos:definition "Relates a symptom-based trigger to the symptom record that caused it."@en .

icare:AchievedGoalAchievementStatus a icare:GoalAchievementStatus,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Achieved goal achievement status"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:intervention-careplan ;
    skos:definition "A goal-achievement status indicating achieved."@en ;
    skos:inScheme icare:GoalAchievementStatusScheme ;
    skos:prefLabel "Achieved goal achievement status"@en ;
    skos:topConceptOf icare:GoalAchievementStatusScheme .

