@prefix icare: <http://maya-project.eu/icareonto/> .
@prefix meta: <http://maya-project.eu/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icare:ClinicalProtocol a owl:Class ;
    rdfs:label "Clinical Protocol"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:KnowledgeResource ;
    skos:definition "A structured resource specifying how a clinical, monitoring, assessment, or study procedure should be performed."@en .

icare:EducationalResource a owl:Class ;
    rdfs:label "Educational Resource"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:KnowledgeResource ;
    skos:definition "A resource designed to improve knowledge, understanding, skills, confidence, or self-management."@en .

icare:EvidenceSource a owl:Class ;
    rdfs:label "Evidence Source"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:KnowledgeResource ;
    skos:definition "A publication, study, review, dataset, or other knowledge resource that reports or synthesises supporting evidence."@en .

icare:Guideline a owl:Class ;
    rdfs:label "Guideline"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:KnowledgeResource ;
    skos:definition "A systematically developed knowledge resource containing recommendations intended to support health, care, or policy decisions."@en .

icare:PolicyRecommendation a owl:Class ;
    rdfs:label "Policy Recommendation"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:Recommendation ;
    skos:definition "A recommendation directed towards policy, organisational, or health-system action."@en .

icare:contraindicationText a owl:DatatypeProperty ;
    rdfs:label "contraindication text"@en ;
    rdfs:domain icare:Contraindication ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable description of a reason the recommendation may be unsuitable."@en .

icare:criterionText a owl:DatatypeProperty ;
    rdfs:label "criterion text"@en ;
    rdfs:domain icare:ApplicabilityCriterion ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable condition under which the recommendation applies."@en .

icare:estimatedCompletionTime a owl:DatatypeProperty ;
    rdfs:label "estimated completion time"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range xsd:duration ;
    skos:definition "Estimated duration required to read, watch, or complete the resource."@en .

icare:healthLiteracyInterventionUsesResource a owl:ObjectProperty ;
    rdfs:label "uses resource"@en ;
    rdfs:domain icare:HealthLiteracyIntervention ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:HealthLiteracyResource ;
    skos:definition "Identifies an approved health-literacy resource delivered or used as part of the intervention."@en .

icare:healthLiteracyResourceAddressesNeed a owl:ObjectProperty ;
    rdfs:label "addresses need"@en ;
    rdfs:domain icare:HealthLiteracyResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:HealthLiteracyNeedType ;
    skos:definition "Relates a health-literacy resource to the health-literacy support need it is designed to address."@en .

icare:knowledgeResourceContainsRecommendation a owl:ObjectProperty ;
    rdfs:label "contains recommendation"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:Recommendation ;
    skos:definition "Indicates that a recommendation appears within the knowledge resource."@en .

icare:knowledgeResourceHasAccessibilityFeature a owl:ObjectProperty ;
    rdfs:label "has accessibility feature"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:AccessibilityFeature ;
    skos:definition "Identifies accessibility support provided by the resource."@en .

icare:knowledgeResourceHasApplicabilityCriterion a owl:ObjectProperty ;
    rdfs:label "has applicability criterion"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ApplicabilityCriterion ;
    skos:definition "Describes conditions under which the resource is suitable."@en .

icare:knowledgeResourceHasAudience a owl:ObjectProperty ;
    rdfs:label "has audience"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ResourceAudienceType ;
    skos:definition "Identifies the intended audience."@en .

icare:knowledgeResourceHasComplexityLevel a owl:ObjectProperty ;
    rdfs:label "has complexity level"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ContentComplexityLevel ;
    skos:definition "Identifies the intended content-complexity level."@en .

icare:knowledgeResourceHasFormat a owl:ObjectProperty ;
    rdfs:label "has format"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ResourceFormat ;
    skos:definition "Identifies the user-facing presentation format."@en .

icare:knowledgeResourceHasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ResourcePurpose ;
    skos:definition "Identifies the educational or communication purpose."@en .

icare:knowledgeResourceHasTopic a owl:ObjectProperty ;
    rdfs:label "has topic"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ResourceTopic ;
    skos:definition "Identifies a health or care topic addressed by a knowledge resource."@en .

icare:knowledgeResourceSupportsRecommendation a owl:ObjectProperty ;
    rdfs:label "supports recommendation"@en ;
    rdfs:domain icare:KnowledgeResource ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:Recommendation ;
    skos:definition "Indicates that a knowledge resource supplies evidence or justification for the recommendation."@en .

icare:recommendationAppliesToSymptom a owl:ObjectProperty ;
    rdfs:label "applies to symptom"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:Symptom ;
    skos:definition "Relates a recommendation to a symptom for which the recommendation is considered applicable, enabling retrieval of symptom-specific guidance. This relation expresses applicability, not diagnosis or causation."@en .

icare:recommendationDerivationPerformedByAgent a owl:ObjectProperty ;
    rdfs:label "performed by agent"@en ;
    rdfs:domain icare:RecommendationDerivation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:DigitalAgent ;
    skos:definition "Relates Recommendation Derivation to Digital Agent."@en .

icare:recommendationDerivationProduces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:domain icare:RecommendationDerivation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:Recommendation ;
    skos:definition "Relates Recommendation Derivation to Recommendation."@en .

icare:recommendationDerivationUsesKnowledgeResource a owl:ObjectProperty ;
    rdfs:label "uses knowledge resource"@en ;
    rdfs:domain icare:RecommendationDerivation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:KnowledgeResource ;
    skos:definition "Relates Recommendation Derivation to Knowledge Resource."@en .

icare:recommendationDerivationUsesModel a owl:ObjectProperty ;
    rdfs:label "uses model"@en ;
    rdfs:domain icare:RecommendationDerivation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:PredictionModel ;
    skos:definition "Relates Recommendation Derivation to Prediction Model."@en .

icare:recommendationDerivationUsesRiskProfile a owl:ObjectProperty ;
    rdfs:label "uses risk profile"@en ;
    rdfs:domain icare:RecommendationDerivation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:RiskProfile ;
    skos:definition "Relates Recommendation Derivation to Risk Profile."@en .

icare:recommendationHasApplicabilityCriterion a owl:ObjectProperty ;
    rdfs:label "has applicability criterion"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:ApplicabilityCriterion ;
    skos:definition "Relates Recommendation to Applicability Criterion."@en .

icare:recommendationHasContraindication a owl:ObjectProperty ;
    rdfs:label "has contraindication"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:Contraindication ;
    skos:definition "Relates Recommendation to Contraindication."@en .

icare:recommendationHasEvidenceGrade a owl:ObjectProperty ;
    rdfs:label "has evidence grade"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:EvidenceGrade ;
    skos:definition "Relates Recommendation to Evidence Grade."@en .

icare:recommendationRecommendsActivity a owl:ObjectProperty ;
    rdfs:label "recommends activity"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range icare:CarePlanActivity ;
    skos:definition "Relates Recommendation to Care Plan Activity."@en .

icare:recommendationText a owl:DatatypeProperty ;
    rdfs:label "recommendation text"@en ;
    rdfs:domain icare:Recommendation ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable wording of the recommendation."@en .

icare:AYASurvivorAudience a icare:ResourceAudienceType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "AYA survivor audience"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "A resource-audience type representing adolescent and young adult cancer survivors."@en ;
    skos:inScheme icare:ResourceAudienceTypeScheme ;
    skos:prefLabel "AYA survivor audience"@en ;
    skos:topConceptOf icare:ResourceAudienceTypeScheme .

