    skos:topConceptOf icare:ResourceFormatScheme .

icare:Contraindication a owl:Class ;
    rdfs:label "Contraindication"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "A condition in which a recommended activity or intervention should not be used, or should be used only with additional assessment or supervision."@en .

icare:HealthLiteracyResource a owl:Class ;
    rdfs:label "Health Literacy Resource"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf icare:KnowledgeResource ;
    skos:definition "A resource specifically designed to address one or more health-literacy dimensions or needs."@en .

icare:RecommendationStrength a owl:Class ;
    rdfs:label "Recommendation Strength"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Strength of a recommendation, kept separate from certainty of evidence."@en .

icare:ApplicabilityCriterion a owl:Class ;
    rdfs:label "Applicability Criterion"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "A textual or structured condition used to determine whether a knowledge resource or recommendation is relevant to a particular person, population, or context."@en .

icare:ContentComplexityLevel a owl:Class ;
    rdfs:label "Content Complexity Level"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Describes the complexity of the content."@en .

icare:RecommendationStrengthScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Recommendation Strength scheme"@en ;
    skos:hasTopConcept icare:ConditionalRecommendation,
        icare:StrongRecommendation .

icare:EvidenceGrade a owl:Class ;
    rdfs:label "Evidence Grade"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled assessment of the certainty or quality of evidence, interpreted according to a named grading scheme."@en .

icare:RecommendationDerivation a owl:Class ;
    rdfs:label "Recommendation Derivation"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "A provenance record describing how an agent or process produced a recommendation from resources, observations, models, or profiles. Not needed if the agent only retrieves and presents approved content."@en .

icare:ResourceAudienceType a owl:Class ;
    rdfs:label "Resource Audience Type"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Intended audience of a knowledge resource."@en .

icare:ContentComplexityLevelScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Content Complexity Level scheme"@en ;
    skos:hasTopConcept icare:AdvancedComplexity,
        icare:FoundationalComplexity,
        icare:StandardComplexity .

icare:AccessibilityFeature a owl:Class ;
    rdfs:label "Accessibility Feature"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Accessibility characteristics available in a resource."@en .

icare:ResourcePurpose a owl:Class ;
    rdfs:label "Resource Purpose"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Intended educational or communication purpose."@en .

icare:EvidenceGradeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Evidence Grade scheme"@en ;
    skos:hasTopConcept icare:HighCertaintyEvidence,
        icare:LowCertaintyEvidence,
        icare:ModerateCertaintyEvidence,
        icare:VeryLowCertaintyEvidence .

icare:ResourceAudienceTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Resource Audience Type scheme"@en ;
    skos:hasTopConcept icare:AYASurvivorAudience,
        icare:CaregiverAudience,
        icare:ClinicianAudience,
        icare:FamilyAudience .

icare:ResourceFormat a owl:Class ;
    rdfs:label "Resource Format"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "User-facing presentation format, distinct from technical file format."@en .

icare:ResourceTopic a owl:Class ;
    rdfs:label "Resource Topic"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Subject focus used for identification or retrieval of a resource."@en .

icare:Recommendation a owl:Class ;
    rdfs:label "Recommendation"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "A statement proposing an action, intervention, activity, or course of care for a specified population or context."@en .

icare:AccessibilityFeatureScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Accessibility Feature scheme"@en ;
    skos:hasTopConcept icare:AudioNarration,
        icare:Captions,
        icare:PlainLanguage,
        icare:ScreenReaderCompatible,
        icare:Transcript,
        icare:VisualSummary .

icare:ResourcePurposeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Resource Purpose scheme"@en ;
    skos:hasTopConcept icare:ExplainHealthTopic,
        icare:PrepareForConsultation,
        icare:SupportBehaviourChange,
        icare:SupportCareNavigation,
        icare:SupportDisclosure,
        icare:SupportSelfManagement .

icare:ResourceFormatScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Resource Format scheme"@en ;
    skos:hasTopConcept icare:Audio,
        icare:Infographic,
        icare:InteractiveDialogue,
        icare:MultimodalResource,
        icare:Quiz,
        icare:Video,
        icare:WrittenText .

icare:KnowledgeResource a owl:Class ;
    rdfs:label "Knowledge Resource"@en ;
    rdfs:isDefinedBy icare:knowledge-resource ;
    skos:definition "An identifiable information resource used to support education, evidence-grounded dialogue, recommendations, care activities, or clinical and study procedures."@en .

icare:ResourceTopicScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Resource Topic scheme"@en ;
    skos:hasTopConcept icare:CardiovascularLateEffects,
        icare:DigitalHealthPrivacyAndTrust,
        icare:FollowUpCare,
        icare:MentalHealthAndEmotionalWellbeing,
        icare:Nutrition,
        icare:PhysicalActivity,
        icare:SelfMonitoring,
        icare:Smoking .

icare:knowledge-resource a owl:Ontology ;
    rdfs:label "Guideline and Knowledge Resource"@en ;
    meta:reviewStatus "Draft" ;
    rdfs:comment "Represents knowledge and educational resources, guidelines, clinical protocols, recommendations and their applicability, evidence and health-literacy characteristics. Knowledge-resource instances use Dublin Core Terms for general bibliographic, publication and rights metadata."@en ;
    owl:imports icare:agent,
        icare:clinical-profile,
        icare:cv-risk,
        <http://maya-project.eu/icareonto/imports/skos-reference>,
        icare:intervention-careplan,
        icare:metadata,
        icare:social-context ;
    owl:versionIRI <http://maya-project.eu/icareonto/releases/0.1.0-draft/knowledge-resource> ;
    owl:versionInfo "0.1.0-draft" .

