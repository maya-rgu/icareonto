    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:social-context ;
    skos:definition "A financial-constraint status indicating that financial limitations affect some health-related choices or participation."@en ;
    skos:inScheme icare:FinancialConstraintStatusValueScheme ;
