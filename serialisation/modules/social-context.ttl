icare:UnknownToPerson a icare:ResponseStatus,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Unknown to person"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:social-context ;
    skos:definition "A response status indicating that the requested information is not known by the person."@en ;
    skos:inScheme icare:ResponseStatusScheme ;
