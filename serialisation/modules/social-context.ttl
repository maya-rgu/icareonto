icare:LivingSituation a owl:Class ;
    rdfs:label "Living Situation"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf icare:SocialContextFactor ;
    skos:definition "Household and housing circumstances relevant to support availability, privacy, digital-service use, or access to care."@en .

icare:SocialContextProfile a owl:Class ;
    rdfs:label "Social Context Profile"@en ;
    rdfs:isDefinedBy icare:social-context ;
    skos:definition "A person-specific collection of social context records used to support context-aware dialogue and adaptation of care activities."@en .

icare:SocioEconomicFactor a owl:Class ;
    rdfs:label "Socio Economic Factor"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf icare:SocialContextFactor ;
    skos:definition "A social or economic circumstance, such as education, employment, or financial resources, that may affect health-related opportunities or participation."@en .

icare:SupportAvailabilityValue a owl:Class ;
    rdfs:label "Support Availability Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted levels of available support"@en .

icare:ContextInfluenceValue a owl:Class ;
    rdfs:label "Context Influence Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Whether a factor is a barrier, facilitator, or mixed"@en .

icare:EducationalAttainmentValue a owl:Class ;
    rdfs:label "Educational Attainment Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted educational attainment values"@en .

icare:FinancialConstraintStatusValue a owl:Class ;
    rdfs:label "Financial Constraint Status Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted financial-constraint states"@en .

icare:SeverityLevel a owl:Class ;
    rdfs:label "Severity Level"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted barrier-severity levels"@en .

icare:AccessOrEngagementBarrier a owl:Class ;
    rdfs:label "Access or Engagement Barrier"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf icare:SocialContextFactor ;
    skos:altLabel "Barrier to Care"@en ;
    skos:definition "A circumstance reported or assessed as impeding access to care, participation, engagement, or sustained use of an intervention."@en .

icare:LanguageProficiencyLevelValue a owl:Class ;
    rdfs:label "Language Proficiency Level Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted language-proficiency levels"@en .

icare:LiteracyLevelValue a owl:Class ;
    rdfs:label "Literacy Level Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted summary levels for digital or health literacy"@en .

icare:LivingSituationType a owl:Class ;
    rdfs:label "Living Situation Type"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted living-arrangement values"@en .

icare:ResponseStatus a owl:Class ;
    rdfs:label "Response Status"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Whether information was provided, unknown, inapplicable, or declined"@en .

icare:ContextInfluenceValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Context Influence Value scheme"@en ;
    skos:hasTopConcept icare:Barrier,
        icare:Facilitator,
        icare:MixedInfluence .

icare:EducationalAttainmentValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Educational Attainment Value scheme"@en ;
    skos:hasTopConcept icare:PrimaryEducation,
        icare:SecondaryEducation,
        icare:TertiaryEducation .

icare:FinancialConstraintStatusValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Financial Constraint Status Value scheme"@en ;
    skos:hasTopConcept icare:NoFinancialConstraint,
        icare:SevereFinancialConstraint,
        icare:SomeFinancialConstraint .

icare:LiteracyLevelValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Literacy Level Value scheme"@en ;
    skos:hasTopConcept icare:AdequateLiteracy,
        icare:HighLiteracy,
        icare:LimitedLiteracy .

icare:SeverityLevelScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Severity Level scheme"@en ;
    skos:hasTopConcept icare:High,
        icare:Low,
        icare:Moderate .

icare:SocialContextRecord a owl:Class ;
    rdfs:label "Social Context Record"@en ;
    rdfs:isDefinedBy icare:social-context ;
    skos:definition "A time- and source-qualified statement or observation about a social context factor affecting a person."@en .

icare:SupportAvailabilityValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Support Availability Value scheme"@en ;
    skos:hasTopConcept icare:ConsistentSupport,
        icare:NoAvailableSupport,
        icare:OccasionalSupport .

icare:EmploymentStatusValue a owl:Class ;
    rdfs:label "Employment Status Value"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted employment-status values"@en .

icare:LanguageProficiencyLevelValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Language Proficiency Level Value scheme"@en ;
    skos:hasTopConcept icare:Fluent,
        icare:Functional,
        icare:LimitedProficiency,
        icare:NoProficiency .

icare:LivingSituationTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Living Situation Type scheme"@en ;
    skos:hasTopConcept icare:LivesAlone,
        icare:LivesWithFamily,
        icare:LivesWithPartner,
        icare:SharedAccommodation .

icare:ResponseStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Response Status scheme"@en ;
    skos:hasTopConcept icare:DeclinedToAnswer,
        icare:NotApplicable,
        icare:Provided,
        icare:UnknownToPerson .

icare:HealthLiteracyNeedType a owl:Class ;
    rdfs:label "Health Literacy Need Type"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying an actionable health-literacy support need identified through assessment or dialogue."@en .

icare:SocialContextFactor a owl:Class ;
    rdfs:label "Social Context Factor"@en ;
    rdfs:isDefinedBy icare:social-context ;
    skos:definition "A social, economic, cultural, interpersonal, or access-related circumstance that may affect care access, engagement, intervention adoption, support needs, or care-plan delivery."@en .

icare:EmploymentStatusValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Employment Status Value scheme"@en ;
    skos:hasTopConcept icare:Employed,
        icare:OnLeave,
        icare:Retired,
        icare:SelfEmployed,
        icare:Student,
        icare:UnableToWork,
        icare:Unemployed .

icare:HealthLiteracyNeedTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Health Literacy Need Type scheme"@en ;
    skos:hasTopConcept icare:CareTeamCommunicationSupportNeed,
        icare:DigitalInteractionSupportNeed,
        icare:HealthcareNavigationSupportNeed,
        icare:InformationAccessSupportNeed,
        icare:InformationApplicationSupportNeed,
        icare:InformationAppraisalSupportNeed,
        icare:InformationComprehensionSupportNeed,
        icare:SelfManagementSupportNeed,
        icare:SocialSupportNeed .

icare:social-context a owl:Ontology ;
    rdfs:label "Social Context"@en ;
    meta:reviewStatus "Draft" ;
    rdfs:comment "Represents person-specific social-context profiles and dated records describing literacy, living and support circumstances, socioeconomic and cultural factors, access barriers and contextual influence."@en ;
    owl:imports icare:core,
        <http://maya-project.eu/icareonto/imports/skos-reference>,
        icare:measurement-biomarker,
        icare:metadata,
        icare:person-role ;
    owl:versionIRI <http://maya-project.eu/icareonto/releases/0.1.0-draft/social-context> ;
    owl:versionInfo "0.1.0-draft" .

