icare:SupportNetwork a owl:Class ;
    rdfs:label "Support Network"@en ;
    rdfs:isDefinedBy icare:social-context ;
    rdfs:subClassOf icare:SocialContextFactor ;
    skos:definition "The people or groups available to provide emotional, informational, practical, or care-related support to a person."@en .

icare:TertiaryEducation a icare:EducationalAttainmentValue,
