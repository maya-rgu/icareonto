@prefix icare: <http://maya-project.eu/icareonto/> .
@prefix meta: <http://maya-project.eu/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icare:agentResponseGeneratedBy a owl:ObjectProperty ;
    rdfs:label "generated by"@en ;
    rdfs:domain icare:AgentResponse ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:ConversationAgent ;
    skos:definition "Identifies the agent that generated a response."@en .

icare:agentResponseGroundedInResource a owl:ObjectProperty ;
    rdfs:label "grounded in resource"@en ;
    rdfs:domain icare:AgentResponse ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:KnowledgeResource ;
    skos:definition "Identifies a knowledge resource used to ground the response."@en .

icare:agentResponseRespondsTo a owl:ObjectProperty ;
    rdfs:label "responds to"@en ;
    rdfs:domain icare:AgentResponse ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:UserUtterance ;
    skos:definition "Identifies the utterance to which the response primarily responds."@en .

icare:agentResponseUsesContext a owl:ObjectProperty ;
    rdfs:label "uses context"@en ;
    rdfs:domain icare:AgentResponse ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:DialogueContext ;
    skos:definition "Identifies the context used to generate a response."@en .

icare:dialogueContextAddressesIntent a owl:ObjectProperty ;
    rdfs:label "addresses intent"@en ;
    rdfs:domain icare:DialogueContext ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:UserIntent ;
    skos:definition "Identifies the intent currently being handled."@en .

icare:dialogueContextHasSlot a owl:ObjectProperty ;
    rdfs:label "has slot"@en ;
    rdfs:domain icare:DialogueContext ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:DialogueSlot ;
    skos:definition "Associates the current context with an expected or populated information slot."@en .

icare:dialogueContextIncludesEntity a owl:ObjectProperty ;
    rdfs:label "includes entity"@en ;
    rdfs:domain icare:DialogueContext ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range owl:Thing ;
    skos:definition "Links the dialogue context to any relevant domain entity."@en .

icare:dialogueSessionDeliveredThroughService a owl:ObjectProperty ;
    rdfs:label "delivered through"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:DigitalService ;
    skos:definition "Identifies the digital service through which a dialogue session was conducted."@en .

icare:dialogueSessionHasAgentParticipant a owl:ObjectProperty ;
    rdfs:label "has agent participant"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:ConversationAgent ;
    skos:definition "Identifies the conversational agent participating in the session."@en .

icare:dialogueSessionHasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:Person ;
    skos:definition "Identifies the person participating in the dialogue session."@en .

icare:dialogueSessionHasTurn a owl:ObjectProperty ;
    rdfs:label "has turn"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:DialogueTurn ;
    skos:definition "Associates a dialogue session with one of its turns."@en .

icare:dialogueSessionStartedAt a owl:ObjectProperty ;
    rdfs:label "started at"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:Timepoint ;
    skos:definition "Identifies when the dialogue session began."@en .

icare:dialogueSessionUsesStrategy a owl:ObjectProperty ;
    rdfs:label "uses strategy"@en ;
    rdfs:domain icare:DialogueSession ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:DialogueStrategy ;
    skos:definition "Identifies a conversational strategy applied during the session."@en .

icare:dialogueSlotConfidence a owl:DatatypeProperty ;
    rdfs:label "dialogue slot confidence"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range xsd:decimal ;
    skos:definition "Optional confidence (between 0 and 1) assigned to the extracted or inferred slot value."@en .

icare:dialogueSlotExtractedFrom a owl:ObjectProperty ;
    rdfs:label "extracted from"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:UserUtterance ;
    skos:definition "Identifies the utterance from which the slot value was extracted."@en .

icare:dialogueSlotHasEntityValue a owl:ObjectProperty ;
    rdfs:label "has entity value"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range owl:Thing ;
    skos:definition "Links a filled slot to a structured ontology entity, such as an exercise activity or observation result."@en .

icare:dialogueSlotHasStatus a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:SlotStatusValue ;
    skos:definition "Identifies whether the slot is filled, missing, ambiguous, or awaiting confirmation."@en .

icare:dialogueSlotHasType a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:SlotType ;
    skos:definition "Identifies the kind of information represented by the slot."@en .

icare:dialogueSlotLiteralValue a owl:DatatypeProperty ;
    rdfs:label "dialogue slot literal value"@en ;
    rdfs:domain icare:DialogueSlot ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range xsd:string ;
    skos:definition "Literal slot value when it is not represented by a structured ontology entity."@en .

icare:dialogueStrategyAdaptedToContext a owl:ObjectProperty ;
    rdfs:label "adapted to context"@en ;
    rdfs:domain icare:DialogueStrategy ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:SocialContextRecord ;
    skos:definition "Indicates that a dialogue strategy was adapted in response to recorded social context."@en .

icare:dialogueTurnOccursAt a owl:ObjectProperty ;
    rdfs:label "occurs at"@en ;
    rdfs:domain icare:DialogueTurn ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:Timepoint ;
    skos:definition "Identifies when a dialogue turn occurred."@en .

icare:turnSequenceNumber a owl:DatatypeProperty ;
    rdfs:label "turn sequence number"@en ;
    rdfs:domain icare:DialogueTurn ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Position of the turn within its dialogue session."@en .

icare:turnText a owl:DatatypeProperty ;
    rdfs:label "turn text"@en ;
    rdfs:domain icare:DialogueTurn ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range xsd:string ;
    skos:definition "Textual content of a user utterance or agent response."@en .

icare:userIntentRequiresSlot a owl:ObjectProperty ;
    rdfs:label "requires slot"@en ;
    rdfs:domain icare:UserIntent ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:SlotType ;
    skos:definition "Identifies information required to fulfil an intent."@en .

icare:userUtteranceExpressesIntent a owl:ObjectProperty ;
    rdfs:label "expresses intent"@en ;
    rdfs:domain icare:UserUtterance ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:range icare:UserIntent ;
    skos:definition "Identifies an intent inferred from the utterance."@en .

icare:ActivityTypeSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Activity type slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture activity type."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Activity type slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:AmbiguousSlot a icare:SlotStatusValue,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Ambiguous slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot status indicating that the available value has more than one plausible interpretation."@en ;
    skos:inScheme icare:SlotStatusValueScheme ;
    skos:prefLabel "Ambiguous slot"@en ;
    skos:topConceptOf icare:SlotStatusValueScheme .

icare:ClarificationStrategy a icare:DialogueStrategy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Clarification strategy"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue strategy based on clarification to support the interaction."@en ;
    skos:inScheme icare:DialogueStrategyScheme ;
    skos:prefLabel "Clarification strategy"@en ;
    skos:topConceptOf icare:DialogueStrategyScheme .

icare:ConfirmInformation a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Confirm information"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to confirm information."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Confirm information"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:EmpathicCommunicationStrategy a icare:DialogueStrategy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Empathic communication strategy"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue strategy based on empathic communication to support the interaction."@en ;
    skos:inScheme icare:DialogueStrategyScheme ;
    skos:prefLabel "Empathic communication strategy"@en ;
    skos:topConceptOf icare:DialogueStrategyScheme .

icare:FilledSlot a icare:SlotStatusValue,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Filled slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot status indicating that a value has been supplied for the slot."@en ;
    skos:inScheme icare:SlotStatusValueScheme ;
    skos:prefLabel "Filled slot"@en ;
    skos:topConceptOf icare:SlotStatusValueScheme .

icare:GoalSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Goal slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture goal."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Goal slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:MeasurementTimeSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Measurement time slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture measurement time."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Measurement time slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:MeasurementTypeSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Measurement type slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture measurement type."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Measurement type slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:MeasurementUnitSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Measurement unit slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture measurement unit."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Measurement unit slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:MeasurementValueSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Measurement value slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture measurement value."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Measurement value slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:MissingSlot a icare:SlotStatusValue,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Missing slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot status indicating that a required or expected value has not been supplied."@en ;
    skos:inScheme icare:SlotStatusValueScheme ;
    skos:prefLabel "Missing slot"@en ;
    skos:topConceptOf icare:SlotStatusValueScheme .

icare:MotivationalInterviewingStrategy a icare:DialogueStrategy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Motivational interviewing strategy"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue strategy based on motivational interviewing to support the interaction."@en ;
    skos:inScheme icare:DialogueStrategyScheme ;
    skos:prefLabel "Motivational interviewing strategy"@en ;
    skos:topConceptOf icare:DialogueStrategyScheme .

icare:NotApplicableSlot a icare:SlotStatusValue,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Not applicable slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot status indicating that the slot does not apply in the current context."@en ;
    skos:inScheme icare:SlotStatusValueScheme ;
    skos:prefLabel "Not applicable slot"@en ;
    skos:topConceptOf icare:SlotStatusValueScheme .

icare:PlainLanguageStrategy a icare:DialogueStrategy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Plain-language strategy"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue strategy based on plain-language to support the interaction."@en ;
    skos:inScheme icare:DialogueStrategyScheme ;
    skos:prefLabel "Plain-language strategy"@en ;
    skos:topConceptOf icare:DialogueStrategyScheme .

icare:RejectInformation a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Reject information"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to reject information."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Reject information"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:ReportActivity a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Report activity"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to report activity."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Report activity"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:ReportMeasurement a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Report measurement"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to report measurement."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Report measurement"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:ReportSymptom a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Report symptom"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to report symptom."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Report symptom"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:RequestExplanation a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Request explanation"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to request explanation."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Request explanation"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:RequestInformation a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Request information"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to request information."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Request information"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:RequestPlanChange a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Request plan change"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to request plan change."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Request plan change"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:RequestRecommendation a icare:UserIntent,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Request recommendation"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A user-intent concept indicating that the user intends to request recommendation."@en ;
    skos:inScheme icare:UserIntentScheme ;
    skos:prefLabel "Request recommendation"@en ;
    skos:topConceptOf icare:UserIntentScheme .

icare:ResourceTopicSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Resource topic slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture resource topic."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Resource topic slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:SymptomOnsetSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Symptom onset slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture symptom onset."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Symptom onset slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:SymptomSeveritySlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Symptom severity slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture symptom severity."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Symptom severity slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:SymptomTypeSlot a icare:SlotType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Symptom type slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot type used to capture symptom type."@en ;
    skos:inScheme icare:SlotTypeScheme ;
    skos:prefLabel "Symptom type slot"@en ;
    skos:topConceptOf icare:SlotTypeScheme .

icare:TeachBackStrategy a icare:DialogueStrategy,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Teach-back strategy"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue strategy based on teach-back to support the interaction."@en ;
    skos:inScheme icare:DialogueStrategyScheme ;
    skos:prefLabel "Teach-back strategy"@en ;
    skos:topConceptOf icare:DialogueStrategyScheme .

icare:UnconfirmedSlot a icare:SlotStatusValue,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Unconfirmed slot"@en ;
    meta:reviewStatus "Proposed" ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A dialogue-slot status indicating that the available value has not yet been confirmed."@en ;
    skos:inScheme icare:SlotStatusValueScheme ;
    skos:prefLabel "Unconfirmed slot"@en ;
    skos:topConceptOf icare:SlotStatusValueScheme .

icare:UserUtterance a owl:Class ;
    rdfs:label "User Utterance"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf icare:DialogueTurn ;
    skos:definition "A dialogue turn containing information communicated by the user through speech, text, or another supported input mode."@en .

icare:AgentResponse a owl:Class ;
    rdfs:label "Agent Response"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf icare:DialogueTurn ;
    skos:definition "A dialogue turn generated by a conversational agent in response to the user or the current dialogue context."@en .

icare:DialogueContext a owl:Class ;
    rdfs:label "Dialogue Context"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A selected set of intents, slot states, domain records, preferences, recommendations, and resources used to interpret an utterance or generate a response."@en .

icare:DialogueSession a owl:Class ;
    rdfs:label "Dialogue Session"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf icare:ActivityExecution ;
    skos:definition "A bounded interaction between a person and a conversational agent, consisting of one or more ordered dialogue turns."@en .

icare:DialogueTurn a owl:Class ;
    rdfs:label "Dialogue Turn"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A temporally ordered contribution made during a dialogue session."@en .

icare:SlotStatusValue a owl:Class ;
    rdfs:label "Slot Status Value"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled value describing the current state of a dialogue slot."@en .

icare:DialogueSlot a owl:Class ;
    rdfs:label "Dialogue Slot"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    skos:definition "A representation of an expected piece of information for the current user intent, including whether it has been supplied, is missing, or requires clarification."@en .

icare:DialogueStrategy a owl:Class ;
    rdfs:label "Dialogue Strategy"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled conversational approach used to adapt communication to the person and context."@en .

icare:DialogueStrategyScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Dialogue Strategy scheme"@en ;
    skos:hasTopConcept icare:ClarificationStrategy,
        icare:EmpathicCommunicationStrategy,
        icare:MotivationalInterviewingStrategy,
        icare:PlainLanguageStrategy,
        icare:TeachBackStrategy .

icare:SlotStatusValueScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Slot Status Value scheme"@en ;
    skos:hasTopConcept icare:AmbiguousSlot,
        icare:FilledSlot,
        icare:MissingSlot,
        icare:NotApplicableSlot,
        icare:UnconfirmedSlot .

icare:SlotType a owl:Class ;
    rdfs:label "Slot Type"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept identifying the kind of information expected for an intent, such as a measurement value, symptom onset, or activity type."@en .

icare:UserIntent a owl:Class ;
    rdfs:label "User Intent"@en ;
    rdfs:isDefinedBy icare:dialogue ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the communicative goal inferred from a user utterance."@en .

icare:UserIntentScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "User Intent scheme"@en ;
    skos:hasTopConcept icare:ConfirmInformation,
        icare:RejectInformation,
        icare:ReportActivity,
        icare:ReportMeasurement,
        icare:ReportSymptom,
        icare:RequestExplanation,
        icare:RequestInformation,
        icare:RequestPlanChange,
        icare:RequestRecommendation .

icare:SlotTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Slot Type scheme"@en ;
    skos:hasTopConcept icare:ActivityTypeSlot,
        icare:GoalSlot,
        icare:MeasurementTimeSlot,
        icare:MeasurementTypeSlot,
        icare:MeasurementUnitSlot,
        icare:MeasurementValueSlot,
        icare:ResourceTopicSlot,
        icare:SymptomOnsetSlot,
        icare:SymptomSeveritySlot,
        icare:SymptomTypeSlot .

icare:dialogue a owl:Ontology ;
    rdfs:label "Dialogue and Conversational Context"@en ;
    meta:reviewStatus "Draft" ;
    rdfs:comment "Represents dialogue sessions and turns, user utterances, agent responses, intents, slots, dialogue context and strategies used for grounded conversational interaction."@en ;
    owl:imports icare:agent,
        icare:core,
        icare:healthhub-service,
        <http://maya-project.eu/icareonto/imports/skos-reference>,
        icare:knowledge-resource,
        icare:metadata,
        icare:person-role,
        icare:social-context ;
    owl:versionIRI <http://maya-project.eu/icareonto/releases/0.1.0-draft/dialogue> ;
    owl:versionInfo "0.1.0-draft" .

